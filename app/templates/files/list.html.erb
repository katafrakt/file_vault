<h1>Your Vault</h1>

<form action="/upload" method="POST" enctype="multipart/form-data">
    <input type="file" name="file">
    <input type="submit" value="Upload new file">
</form>

<% files.each do |file| %>
  <div>
    <p><%= file.filename %></p>
    <ul>
      <% if file.title %><li>Title: <%= file.title %></li><% end %>
      <% if file.author %><li>Author: <%= file.author %></li><% end %>
      <% if file.description %><li>Description: <%= file.description %></li><% end %>
      <% if file.pages %><li>Pages: <%= file.pages %></li><% end %>
      <% if file.image_width && file.image_height %><li>Image size: <%= file.image_width %>x<%= file.image_height %> px</li><% end %>
    </ul>
  </div>
<% end %>
