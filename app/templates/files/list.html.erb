<div class="grid-row">
  <div class="grid-col-8 grid-col-medium-4 grid-col-small-4">
    <h1 class="p-heading--1">Your Vault</h1>

    <form action="/upload" method="POST" enctype="multipart/form-data" class="p-form p-form--inline">
      <div class="p-form__group">
        <input type="file" name="file">
        <input type="submit" class="p-button--positive" value="Upload new file">
      </div>
    </form>
  </div>
</div>

<div class="grid-row">
  <% files.each do |file| %>
    <div class="grid-col-2 grid-col-medium-2 grid-col-small-2">
      <div class="p-card">
        <h5 class="p-heading--5"><%= file.filename %></h5>
        <hr class="u-sv1">
        <div class="p-card__content">
          <ul>
            <% if file.title %><li>Title: <%= file.title %></li><% end %>
            <% if file.author %><li>Author: <%= file.author %></li><% end %>
            <% if file.description %><li>Description: <%= file.description %></li><% end %>
            <% if file.pages %><li>Pages: <%= file.pages %></li><% end %>
            <% if file.image_width && file.image_height %><li>Image size: <%= file.image_width %>x<%= file.image_height %> px</li><% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>
</div>
